{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JuniorAstronautMissionConfig",
  "type": "object",
  "required": [
    "schema_version",
    "mission",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.1"]
    },
    "mission": {
      "type": "object",
      "required": ["crew_size"],
      "properties": {
        "crew_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter_id",
          "resource",
          "flow_type",
          "value_per_person",
          "unit",
          "period",
          "data_status",
          "source",
          "assumptions",
          "notes"
        ],
        "properties": {
          "parameter_id": { "type": "string" },
          "resource": { "type": "string" },
          "flow_type": { "type": "string" },
          "value_per_person": { "type": ["number", "null"] },
          "raw_value": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "period": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string" }
            }
          },
          "data_status": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "assumptions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
